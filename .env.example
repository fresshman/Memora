# Memora 配置文件
# 用法：复制本文件为 .env，按需修改。.env 不提交到仓库。
# 所有配置均可被同名系统环境变量覆盖（.env 优先级低于系统环境变量）。

# ---------------------------------------------------------------------------
# 路径
# ---------------------------------------------------------------------------
# 模型根目录（ModelScope cache_dir）；snapshot_download 会在其下生成
#   models/XHToken--Spark-X2.5-4B/snapshots/<版本>/...
# 留空时程序默认取「项目上级目录/root/models」（见 memora/config.py）。
# 如需自定义，取消下一行注释并改为本机路径（注意用正斜杠 /）：
# MEMORA_MODELS_ROOT=D:/Memora/root/models

# 当前选中的模型（也可在前端「模型管理」页切换，持久化到 data/settings.json）
MEMORA_MODEL_ID=XHToken/Spark-X2.5-4B

# ---------------------------------------------------------------------------
# 推理后端选择
#   llamacpp -> 默认，后端自动拉起本机 llama-server 子进程（OpenAI 兼容），
#               免编译、免 torch，二进制在 tools/llamacpp/bin 或同级 ../llama.cpp
#   sglang   -> 可选，连接本机已启动的 sglang server（OpenAI 兼容端点）
# ---------------------------------------------------------------------------
MEMORA_BACKEND=llamacpp

# SGLang server 配置（仅 MEMORA_BACKEND=sglang 时生效）
MEMORA_SGLANG_URL=http://127.0.0.1:30000/v1
MEMORA_SGLANG_KEY=EMPTY
# 留空则自动跟随选中模型的仓库末段名称
MEMORA_SGLANG_MODEL=

# ---------------------------------------------------------------------------
# llama.cpp 推理参数（8GB 内存友好的默认值）
#   N_CTX：上下文窗口。默认 32768 + KV q8，总占用约 3.5GB。
#          16GB 以上内存可调 65536；196608 仅建议 KV q4 + 16GB 以上。
#          注意 fp16 KV 下 196608 仅 KV 缓存约 6.75GB，8GB 机器会爆内存。
#   N_GPU：0 = 全 CPU（默认）；有显卡填卸载层数（如 99），-1 = 全部上 GPU。
#   THREADS：0 = 自动。
#   KV_QUANT：KV cache 量化 q8_0（默认）/ q4_0 / f16。
# ---------------------------------------------------------------------------
MEMORA_N_CTX=32768
MEMORA_N_GPU=0
MEMORA_THREADS=0
MEMORA_KV_QUANT=q8_0

# 输入截断字符数（默认按 n_ctx 自动换算，中文约 1 字≈1.3 token）；一般无需手动设置
# MEMORA_MAX_INPUT_CHARS=20000


# ---------------------------------------------------------------------------
# RAG 检索增强（超长对话，纯 CPU、无 torch）
#   短对话（<= 触发字符数）全量直喂，零损耗；超长对话启用本地 bge-m3 embedding
#   + faiss 混合检索（多路语义召回 + 时间线骨架），避免旧版直接砍掉最旧记录。
#   embedding 模型需另行下载（约 438MB，复用 llama-server）：
#     snapshot_download('gpustack/bge-m3-GGUF', allow_file_pattern=['*Q4_K_M*'])
#   未装 embedding 时自动降级为「规则时间线压缩」，仍覆盖各话题段。
# ---------------------------------------------------------------------------
MEMORA_RAG_ENABLE=1
# MEMORA_RAG_TRIGGER_CHARS=20100   # 超过该字数才启用 RAG，默认=输入截断字数
# MEMORA_RAG_CHUNK_CHARS=420       # 每块字符预算
# MEMORA_RAG_CHUNK_OVERLAP=2       # 相邻块回带消息数
# MEMORA_RAG_GAP_MIN=30            # 相邻消息间隔超过该分钟数即切话题
# MEMORA_RAG_TOPK=14               # 语义召回块上限
# MEMORA_EMBED_REPO=gpustack/bge-m3-GGUF
# MEMORA_EMBED_PATTERN=*Q4_K_M*

# ---------------------------------------------------------------------------
# PII 本地脱敏（端侧隐私，默认开启）
#   解析后、送入模型 / 建立向量索引前，对手机 / 身份证 / 银行卡 / 邮箱 /
#   IPv4 / 车牌 / 护照等强模式信息占位脱敏，发言人统一角色化为成员A/B…。
#   映射仅保存在会话内存、不落盘，报告生成后可在前端本机一键还原。
# ---------------------------------------------------------------------------
MEMORA_PII_REDACT=1
# MEMORA_PII_REDACT_NAMES=1   # 置 0 则只脱敏号码/证件，不角色化人名

# ---------------------------------------------------------------------------
# 生成参数
# ---------------------------------------------------------------------------
MEMORA_TEMP=0.3
MEMORA_MAX_REVIEW=4096
MEMORA_MAX_QA=1024

# ---------------------------------------------------------------------------
# 离线安全红线
#   1（默认）-> 模型缺失绝不联网，只报错指引（比赛断网演示场景）
#   0        -> 允许在「模型管理」页从 ModelScope 下载模型（安装阶段用网）
# ---------------------------------------------------------------------------
MEMORA_ENFORCE_OFFLINE=1

# ---------------------------------------------------------------------------
# 模型获取
# ---------------------------------------------------------------------------
# Whisper 模型的 ModelScope 仓库 ID；ModelScope 上若无则报错附手动指引
MEMORA_WHISPER_MS_ID=AI-ModelScope/whisper.cpp

# llama.cpp 仓库路径（safetensors→GGUF 转换兜底链路用）；空则自动找同级 ../llama.cpp
# Spark2_5 架构需 2026-09-07 之后合入的 llama.cpp
MEMORA_LLAMACPP_PATH=

# llama-server 可执行文件显式路径；空则自动查找
#   tools/llamacpp/bin/llama-server(.exe) → 同级 ../llama.cpp/build/bin → PATH
# MEMORA_LLAMASERVER_PATH=
# 固定推理端口；0 = 每次自动挑选空闲端口（默认，避免多实例冲突）
# MEMORA_LLAMASERVER_PORT=0
# server 启动/模型加载超时秒数
# MEMORA_SERVER_BOOT_TIMEOUT=300
# llama-server 详细日志（排查问题时设 1，日志在 data/logs/llama-server.log）
# MEMORA_LLAMACPP_VERBOSE=0
